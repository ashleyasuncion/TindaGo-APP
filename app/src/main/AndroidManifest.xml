<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- V2.70: local notifications. No effect below Android 13; runtime
         permission on 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SMS feature: send debt receipts and reminders automatically.
         NOTE: Google Play blocks SEND_SMS for non-default-SMS-handler apps.
         This works only for sideloaded/beta APKs (capstone demo). -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <application
        android:name=".TindaGoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TindaGo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TindaGo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- V2.70: notification deep links (tindago://morning | inventory | closing | debts) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tindago" />
            </intent-filter>
        </activity>

    </application>

</manifest>